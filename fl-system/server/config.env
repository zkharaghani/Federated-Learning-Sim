# ===== Edit this file before running anything =====

# Public/LAN IP of the server machine that clients can reach.
# It is written into the TLS certificate (SAN), so it must be exact.
SERVER_IP=192.168.1.10

# Flower SuperLink port (Fleet API for SuperNodes + Control API for `flwr run`)
SUPERLINK_PORT=9092

# Bootstrap/provisioning HTTPS port (clients download Docker files + certs here)
BOOTSTRAP_PORT=8443

# Client IDs (one per client machine). partition-id = position in this list.
CLIENTS="client1 client2"

# Flower version used everywhere (server, client images, local CLI)
FLWR_VERSION=1.40.0
